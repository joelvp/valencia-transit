{
  "name": "valencia-transit",
  "version": "0.1.0",
  "description": "Transit information system for Valencia's metro network",
  "module": "src/main.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run src/main.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "import:gtfs": "bun run scripts/import-gtfs.ts"
  },
  "dependencies": {
    "@grammyjs/ratelimiter": "^1.2.1",
    "adm-zip": "^0.6.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "fuse.js": "^7.1.0",
    "grammy": "^1.41.1",
    "i18next": "^26.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/adm-zip": "^0.5.7",
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.0"
  },
  "engines": {
    "bun": "1.3.11"
  }
}
